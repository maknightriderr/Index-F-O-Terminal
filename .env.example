# ============================================================
# F&O TERMINAL - ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# --- Angel One SmartAPI ---
ANGEL_ONE_API_KEY=your_smartapi_key
ANGEL_ONE_CLIENT_ID=your_client_code
ANGEL_ONE_PASSWORD=your_mpin_or_password
ANGEL_ONE_TOTP_SECRET=your_totp_secret

# --- Database (PostgreSQL + TimescaleDB) ---
DATABASE_URL=postgresql://fno_user:fno_dev_password@localhost:5432/fno_terminal

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Backend Server ---
SERVER_PORT=4000
SERVER_HOST=0.0.0.0
NODE_ENV=development
# Comma-separated list of origins allowed to call the API/WebSocket.
# Must include your deployed Vercel URL in production.
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# --- Auth ---
JWT_SECRET=your_jwt_secret_minimum_32_chars_long
JWT_EXPIRY=24h

# --- AI Assistant (optional — Phase 12) ---
# OPENAI_API_KEY=your_openai_key
# AI_PROVIDER=openai

# --- Alerts (optional — Phase 9) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email
# SMTP_PASS=your_app_password
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# TELEGRAM_CHAT_ID=your_telegram_chat_id
